{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate",
  "version": "0.1.0",
  "identifier": "io.github.aayushmanrajput45-beep.slate",
  "build": {
    "beforeDevCommand": "npm run tauri -- icon public/icon.svg --output src-tauri/icons && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run tauri -- icon public/icon.svg --output src-tauri/icons && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Slate",
        "url": "index.html",
        "width": 1100,
        "height": 700,
        "minWidth": 480,
        "minHeight": 400,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#111315"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "aayushmanrajput45-beep",
    "shortDescription": "Slate developer workspace",
    "homepage": "https://slate-aayushmanrajput45.pages.dev",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
